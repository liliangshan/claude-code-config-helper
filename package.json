{
    "name": "claude-code-config-helper",
    "displayName": "%extension.displayName%",
    "description": "%extension.description%",
    "version": "3.2.19",
    "publisher": "liliangshan",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/liliangshan/claude-code-config-helper.git"
    },
    "icon": "resources/marketplace-icon.png",
    "engines": {
        "vscode": "^1.94.0"
    },
    "categories": [
        "AI",
        "Other"
    ],
    "keywords": [
        "claude",
        "claude-code",
        "anthropic",
        "router",
        "proxy"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "claudeRouter.openConfigPanel",
                "title": "%command.openConfigPanel.title%",
                "category": "%command.category%",
                "icon": "$(settings-gear)"
            },
            {
                "command": "claudeRouter.openSettingsJson",
                "title": "%command.openSettingsJson.title%",
                "category": "%command.category%"
            },
            {
                "command": "claudeRouter.openGlobalSharedSettings",
                "title": "%command.openGlobalSharedSettings.title%",
                "category": "%command.category%"
            },
            {
                "command": "claudeRouter.openWorkspaceSharedSettings",
                "title": "%command.openWorkspaceSharedSettings.title%",
                "category": "%command.category%"
            },
            {
                "command": "claudeRouter.reloadWindow",
                "title": "%command.reloadWindow.title%",
                "category": "%command.category%"
            },
            {
                "command": "claudeRouter.chat.open",
                "title": "%command.chat.open.title%",
                "category": "%command.category%",
                "icon": "$(comment-discussion)"
            },
            {
                "command": "claudeRouter.chat.selectCli",
                "title": "%command.chat.selectCli.title%",
                "category": "%command.category%"
            },
            {
                "command": "claudeRouter.chat.restart",
                "title": "%command.chat.restart.title%",
                "category": "%command.category%"
            },
            {
                "command": "claudeRouter.refreshProviders",
                "title": "%command.refreshProviders.title%",
                "category": "%command.category%",
                "icon": "$(refresh)"
            },
            {
                "command": "claudeRouter.newProvider",
                "title": "%command.newProvider.title%",
                "category": "%command.category%",
                "icon": "$(add)"
            },
            {
                "command": "claudeRouter.editProviderItem",
                "title": "%command.editProviderItem.title%",
                "category": "%command.category%",
                "icon": "$(edit)"
            },
            {
                "command": "claudeRouter.deleteProviderItem",
                "title": "%command.deleteProviderItem.title%",
                "category": "%command.category%",
                "icon": "$(trash)"
            },
            {
                "command": "claudeRouter.setCurrentModel",
                "title": "%command.setCurrentModel.title%",
                "category": "%command.category%"
            },
            {
                "command": "claudeRouter.clearCurrentModel",
                "title": "%command.clearCurrentModel.title%",
                "category": "%command.category%"
            },
            {
                "command": "claudeRouter.pasteTaskFlowToClaude",
                "title": "%command.pasteTaskFlowToClaude.title%",
                "category": "%command.category%"
            },
            {
                "command": "claudeRouter.llsCcaiTask.openMenu",
                "title": "%command.llsCcaiTask.openMenu.title%",
                "category": "%command.category%"
            },
            {
                "command": "claudeRouter.llsCcaiTask.showProgress",
                "title": "%command.llsCcaiTask.showProgress.title%",
                "category": "%command.category%"
            },
            {
                "command": "claudeRouter.llsCcaiTask.continue",
                "title": "%command.llsCcaiTask.continue.title%",
                "category": "%command.category%"
            },
            {
                "command": "claudeRouter.llsCcaiTask.clear",
                "title": "%command.llsCcaiTask.clear.title%",
                "category": "%command.category%"
            },
            {
                "command": "claudeRouter.testSimulateEnter",
                "title": "%command.testSimulateEnter.title%",
                "category": "%command.category%"
            },
            {
                "command": "claudeRouter.exportConfig",
                "title": "%command.exportConfig.title%",
                "category": "%command.category%"
            },
            {
                "command": "claudeRouter.importConfig",
                "title": "%command.importConfig.title%",
                "category": "%command.category%"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "claudeRouter",
                    "title": "%view.container.title%",
                    "icon": "resources/activity-bar.svg"
                }
            ],
            "secondarySidebar": [
                {
                    "id": "claudeRouterChatSecondary",
                    "title": "%view.chat.container.title%",
                    "icon": "resources/reference-claude-logo.svg",
                    "when": "!claudeRouter.chat.useActivityBarFallback"
                }
            ]
        },
        "views": {
            "claudeRouter": [
                {
                    "id": "claudeRouter.providersView",
                    "type": "webview",
                    "name": "%view.providers.name%",
                    "icon": "resources/activity-bar.svg",
                    "contextualTitle": "%view.providers.contextualTitle%"
                }
            ],
            "claudeRouterChatSecondary": [
                {
                    "id": "claudeRouter.chatSidebarSecondary",
                    "type": "webview",
                    "name": "%view.chat.name%",
                    "icon": "resources/reference-claude-logo.svg"
                }
            ]
        },
        "configuration": {
            "title": "%configuration.title%",
            "properties": {
                "claudeCodeConfigHelper.autoReloadWindow": {
                    "type": "boolean",
                    "default": false,
                    "description": "%configuration.autoReloadWindow.description%"
                },
                "claudeCodeConfigHelper.language": {
                    "type": "string",
                    "enum": [
                        "auto",
                        "en",
                        "zh-cn",
                        "zh-tw",
                        "ko",
                        "ja",
                        "fr",
                        "de"
                    ],
                    "default": "auto",
                    "description": "%configuration.language.description%",
                    "scope": "application"
                },
                "claudeCodeConfigHelper.taskFlowBypassPermissions": {
                    "type": "boolean",
                    "default": false,
                    "description": "%configuration.taskFlowBypassPermissions.description%",
                    "scope": "application"
                },
                "claudeCodeConfigHelper.taskFlow.target": {
                    "type": "string",
                    "enum": [
                        "externalClaudeCode",
                        "builtinChat"
                    ],
                    "default": "externalClaudeCode",
                    "description": "%configuration.taskFlow.target.description%",
                    "scope": "resource"
                },
                "claudeCodeConfigHelper.chat.enabled": {
                    "type": "boolean",
                    "default": false,
                    "description": "%configuration.chat.enabled.description%",
                    "scope": "resource"
                },
                "claudeCodeConfigHelper.chat.cliPath": {
                    "type": "string",
                    "default": "",
                    "description": "%configuration.chat.cliPath.description%",
                    "scope": "machine-overridable"
                },
                "claudeCodeConfigHelper.chat.cliArgs": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "description": "%configuration.chat.cliArgs.description%",
                    "scope": "machine-overridable"
                },
                "claudeCodeConfigHelper.chat.cliCwd": {
                    "type": "string",
                    "default": "",
                    "description": "%configuration.chat.cliCwd.description%",
                    "scope": "resource"
                },
                "claudeCodeConfigHelper.chat.transport": {
                    "type": "string",
                    "enum": [
                        "streamJsonStdio",
                        "printStdio",
                        "pty"
                    ],
                    "default": "streamJsonStdio",
                    "description": "%configuration.chat.transport.description%",
                    "scope": "resource"
                },
                "claudeCodeConfigHelper.chat.cliEnv": {
                    "type": "object",
                    "default": {},
                    "description": "%configuration.chat.cliEnv.description%",
                    "scope": "machine-overridable"
                },
                "claudeCodeConfigHelper.chat.permissionMode": {
                    "type": "string",
                    "enum": [
                        "default",
                        "acceptEdits",
                        "bypassPermissions",
                        "auto",
                        "dontAsk",
                        "plan"
                    ],
                    "default": "acceptEdits",
                    "description": "%configuration.chat.permissionMode.description%",
                    "scope": "resource"
                },
                "claudeCodeConfigHelper.chat.mcpServers": {
                    "type": "object",
                    "default": {},
                    "additionalProperties": {
                        "type": "object",
                        "properties": {
                            "type": {
                                "type": "string",
                                "enum": [
                                    "stdio",
                                    "http",
                                    "sse",
                                    "sdk"
                                ],
                                "description": "%configuration.chat.mcpServers.type.description%"
                            },
                            "command": {
                                "type": "string"
                            },
                            "args": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            },
                            "env": {
                                "type": "object",
                                "additionalProperties": {
                                    "type": "string"
                                }
                            },
                            "cwd": {
                                "type": "string"
                            },
                            "url": {
                                "type": "string"
                            },
                            "headers": {
                                "type": "object",
                                "additionalProperties": {
                                    "type": "string"
                                }
                            }
                        },
                        "additionalProperties": true
                    },
                    "description": "%configuration.chat.mcpServers.description%",
                    "scope": "resource"
                },
                "claudeCodeConfigHelper.chat.strictMcpConfig": {
                    "type": "boolean",
                    "default": false,
                    "description": "%configuration.chat.strictMcpConfig.description%",
                    "scope": "resource"
                },
                "claudeCodeConfigHelper.chat.includeVscodeMcpJson": {
                    "type": "boolean",
                    "default": true,
                    "description": "%configuration.chat.includeVscodeMcpJson.description%",
                    "scope": "resource"
                },
                "claudeCodeConfigHelper.chat.skills": {
                    "default": null,
                    "anyOf": [
                        {
                            "type": "null"
                        },
                        {
                            "type": "string",
                            "enum": [
                                "all"
                            ]
                        },
                        {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    ],
                    "description": "%configuration.chat.skills.description%",
                    "scope": "resource"
                },
                "claudeCodeConfigHelper.chat.browserTools.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "%configuration.chat.browserTools.enabled.description%",
                    "scope": "resource"
                },
                "claudeCodeConfigHelper.editor.autoOpenReadWriteFiles": {
                    "type": "boolean",
                    "default": true,
                    "description": "%configuration.editor.autoOpenReadWriteFiles.description%",
                    "scope": "resource"
                },
                "claudeCodeConfigHelper.vscodeTools.getErrors.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "%configuration.vscodeTools.getErrors.enabled.description%",
                    "scope": "resource"
                },
                "claudeCodeConfigHelper.chat.currentModel": {
                    "type": [
                        "object",
                        "null"
                    ],
                    "default": null,
                    "properties": {
                        "providerId": {
                            "type": "string"
                        },
                        "modelId": {
                            "type": "string"
                        }
                    },
                    "additionalProperties": false,
                    "description": "%configuration.chat.currentModel.description%",
                    "scope": "resource"
                },
                "claudeCodeConfigHelper.chat.expertMode.project.enabled": {
                    "type": "boolean",
                    "default": false,
                    "description": "%configuration.chat.expertMode.project.enabled.description%",
                    "scope": "resource"
                },
                "claudeCodeConfigHelper.chat.expertMode.project.model": {
                    "type": "string",
                    "default": "",
                    "description": "%configuration.chat.expertMode.project.model.description%",
                    "scope": "resource"
                },
                "claudeCodeConfigHelper.chat.expertMode.global.enabled": {
                    "type": "boolean",
                    "default": false,
                    "description": "%configuration.chat.expertMode.global.enabled.description%",
                    "scope": "application"
                },
                "claudeCodeConfigHelper.chat.expertMode.global.model": {
                    "type": "string",
                    "default": "",
                    "description": "%configuration.chat.expertMode.global.model.description%",
                    "scope": "application"
                },
                "claudeCodeConfigHelper.chat.compactionMode.project.enabled": {
                    "type": "boolean",
                    "default": false,
                    "description": "%configuration.chat.compactionMode.project.enabled.description%",
                    "scope": "resource"
                },
                "claudeCodeConfigHelper.chat.compactionMode.project.model": {
                    "type": "string",
                    "default": "",
                    "description": "%configuration.chat.compactionMode.project.model.description%",
                    "scope": "resource"
                },
                "claudeCodeConfigHelper.chat.compactionMode.global.enabled": {
                    "type": "boolean",
                    "default": false,
                    "description": "%configuration.chat.compactionMode.global.enabled.description%",
                    "scope": "application"
                },
                "claudeCodeConfigHelper.chat.compactionMode.global.model": {
                    "type": "string",
                    "default": "",
                    "description": "%configuration.chat.compactionMode.global.model.description%",
                    "scope": "application"
                },
                "claudeCodeConfigHelper.chat.planMode.project.enabled": {
                    "type": "boolean",
                    "default": false,
                    "description": "%configuration.chat.planMode.project.enabled.description%",
                    "scope": "resource"
                },
                "claudeCodeConfigHelper.chat.planMode.project.model": {
                    "type": "string",
                    "default": "",
                    "description": "%configuration.chat.planMode.project.model.description%",
                    "scope": "resource"
                },
                "claudeCodeConfigHelper.chat.planMode.global.enabled": {
                    "type": "boolean",
                    "default": false,
                    "description": "%configuration.chat.planMode.global.enabled.description%",
                    "scope": "application"
                },
                "claudeCodeConfigHelper.chat.planMode.global.model": {
                    "type": "string",
                    "default": "",
                    "description": "%configuration.chat.planMode.global.model.description%",
                    "scope": "application"
                },
                "claudeCodeConfigHelper.chat.reviewMode.project.enabled": {
                    "type": "boolean",
                    "default": false,
                    "description": "%configuration.chat.reviewMode.project.enabled.description%",
                    "scope": "resource"
                },
                "claudeCodeConfigHelper.chat.reviewMode.project.model": {
                    "type": "string",
                    "default": "",
                    "description": "%configuration.chat.reviewMode.project.model.description%",
                    "scope": "resource"
                },
                "claudeCodeConfigHelper.chat.reviewMode.global.enabled": {
                    "type": "boolean",
                    "default": false,
                    "description": "%configuration.chat.reviewMode.global.enabled.description%",
                    "scope": "application"
                },
                "claudeCodeConfigHelper.chat.reviewMode.global.model": {
                    "type": "string",
                    "default": "",
                    "description": "%configuration.chat.reviewMode.global.model.description%",
                    "scope": "application"
                },
                "claudeCodeConfigHelper.chat.dispatcher.appendSystemPrompt": {
                    "type": "string",
                    "default": "",
                    "description": "%configuration.chat.dispatcher.appendSystemPrompt.description%",
                    "scope": "resource"
                },
                "claudeCodeConfigHelper.chat.expert.appendSystemPrompt": {
                    "type": "string",
                    "default": "",
                    "description": "%configuration.chat.expert.appendSystemPrompt.description%",
                    "scope": "resource"
                },
                "claudeCodeConfigHelper.chat.expert.userTriggerMode": {
                    "type": "string",
                    "enum": ["direct", "tool_result"],
                    "default": "direct",
                    "description": "%configuration.chat.expert.userTriggerMode.description%",
                    "scope": "resource"
                },
                "claudeCodeConfigHelper.chat.expert.maxSteps": {
                    "type": "number",
                    "default": 6,
                    "minimum": 1,
                    "maximum": 50,
                    "description": "%configuration.chat.expert.maxSteps.description%",
                    "scope": "resource"
                },
                "claudeCodeConfigHelper.chat.expert.stepTimeoutMs": {
                    "type": "number",
                    "default": 60000,
                    "minimum": 1000,
                    "description": "%configuration.chat.expert.stepTimeoutMs.description%",
                    "scope": "resource"
                },
                "claudeCodeConfigHelper.chat.expert.totalTimeoutMs": {
                    "type": "number",
                    "default": 300000,
                    "minimum": 1000,
                    "description": "%configuration.chat.expert.totalTimeoutMs.description%",
                    "scope": "resource"
                },
                "claudeCodeConfigHelper.chat.expert.maxCallsPerTurn": {
                    "type": "number",
                    "default": 1,
                    "minimum": 1,
                    "maximum": 10,
                    "description": "%configuration.chat.expert.maxCallsPerTurn.description%",
                    "scope": "resource"
                },
                "openapicopilot.systemPrompt": {
                    "type": "string",
                    "default": "",
                    "description": "%configuration.openapicopilot.systemPrompt.description%",
                    "scope": "machine-overridable"
                }
            }
        },
        "menus": {
            "commandPalette": [
                {
                    "command": "claudeRouter.openConfigPanel"
                },
                {
                    "command": "claudeRouter.openSettingsJson"
                },
                {
                    "command": "claudeRouter.openGlobalSharedSettings"
                },
                {
                    "command": "claudeRouter.openWorkspaceSharedSettings"
                },
                {
                    "command": "claudeRouter.chat.open"
                },
                {
                    "command": "claudeRouter.chat.selectCli"
                },
                {
                    "command": "claudeRouter.chat.restart"
                },
                {
                    "command": "claudeRouter.pasteTaskFlowToClaude"
                },
                {
                    "command": "claudeRouter.llsCcaiTask.openMenu"
                },
                {
                    "command": "claudeRouter.llsCcaiTask.showProgress"
                },
                {
                    "command": "claudeRouter.llsCcaiTask.continue"
                },
                {
                    "command": "claudeRouter.llsCcaiTask.clear"
                },
                {
                    "command": "claudeRouter.reloadWindow"
                },
                {
                    "command": "claudeRouter.newProvider"
                },
                {
                    "command": "claudeRouter.refreshProviders"
                },
                {
                    "command": "claudeRouter.setCurrentModel"
                },
                {
                    "command": "claudeRouter.clearCurrentModel"
                },
                {
                    "command": "claudeRouter.exportConfig"
                },
                {
                    "command": "claudeRouter.importConfig"
                },
                {
                    "command": "claudeRouter.editProviderItem",
                    "when": "false"
                },
                {
                    "command": "claudeRouter.deleteProviderItem",
                    "when": "false"
                }
            ],
            "view/title": [
                {
                    "command": "claudeRouter.newProvider",
                    "when": "view == claudeRouter.providersView",
                    "group": "navigation@1"
                },
                {
                    "command": "claudeRouter.openConfigPanel",
                    "when": "view == claudeRouter.providersView",
                    "group": "navigation@2"
                },
                {
                    "command": "claudeRouter.refreshProviders",
                    "when": "view == claudeRouter.providersView",
                    "group": "navigation@3"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "typecheck": "tsc --noEmit -p ./",
        "test": "npm run compile && node --test out/chat/__tests__/*.test.js"
    },
    "devDependencies": {
        "@types/node": "^20.11.0",
        "@types/vscode": "^1.94.0",
        "typescript": "^5.4.0"
    },
    "dependencies": {
        "js-tiktoken": "^1.0.21"
    }
}
